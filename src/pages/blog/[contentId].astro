---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogList, getBlogDetail, type Blog } from '../../library/microcms';
import { sitePath } from '../../library/site';

export async function getStaticPaths() {
  try {
    const response = await getBlogList({
      fields: ['id'],
      limit: 100,
    });
    return response.contents.map((content) => ({
      params: {
        contentId: content.id,
      },
    }));
  } catch (error) {
    return [];
  }
}

const { contentId } = Astro.params;

let blog: Blog | null = null;
if (contentId) {
  try {
    blog = await getBlogDetail(contentId as string);
  } catch (error) {
    blog = null;
  }
}

function formatDate(dateString?: string): string {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={blog?.title || 'ブログ'}>
  <a href={sitePath('/#blog')} class="mb-6 inline-block text-[0.95rem] text-blue-600 no-underline hover:underline">
    ← トップページに戻る
  </a>

  {
    blog ? (
      <article class="rounded-lg border border-gray-200 bg-white p-8">
        <div class="mb-3 flex items-center gap-3">
          <span class="text-sm text-gray-500">{formatDate(blog.publishedAt || blog.createdAt)}</span>
          {blog.category && (
            <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-sm font-semibold text-blue-600">
              {blog.category.name}
            </span>
          )}
        </div>
        <h1 class="mb-6 border-b border-gray-200 pb-4 text-3xl font-bold leading-snug text-gray-900">{blog.title}</h1>
        {(blog.mainVisual || blog.eyecatch) &&
          (() => {
            const visual = blog.mainVisual || blog.eyecatch;
            return visual?.url ? (
              <div class="mb-6 overflow-hidden rounded-md">
                <img
                  src={visual.url}
                  alt={blog.title || 'メインビジュアル'}
                  width={visual.width}
                  height={visual.height}
                  class="block h-auto w-full"
                />
              </div>
            ) : null;
          })()}
        <div class="cms-content mt-6" set:html={blog.content} />
      </article>
    ) : (
      <p>記事が見つかりませんでした。</p>
    )
  }
</BaseLayout>
