---
import { getBlogList, getBlogDetail, type Blog } from '../../library/microcms';

/**
 * ビルド時に全ブログ記事のパス（URL）を生成する関数
 */
export async function getStaticPaths() {
  try {
    const response = await getBlogList({
      fields: ['id'],
      limit: 100,
    });
    return response.contents.map((content) => ({
      params: {
        contentId: content.id,
      },
    }));
  } catch (error) {
    // データ取得失敗時のフォールバック
    return [];
  }
}

// URLパラメータから記事IDを取得
const { contentId } = Astro.params;

// 記事詳細データを取得
let blog: Blog | null = null;
if (contentId) {
  try {
    blog = await getBlogDetail(contentId as string);
  } catch (error) {
    blog = null;
  }
}

/**
 * 日付フォーマット関数
 */
function formatDate(dateString?: string): string {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{blog ? `${blog.title} - ブログ` : 'ブログ'}</title>
    <style>
      :root {
        --color-primary: #2563eb;
        --color-text: #1f2937;
        --color-subtext: #6b7280;
        --color-bg: #f9fafb;
        --color-card-bg: #ffffff;
        --color-border: #e5e7eb;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.8;
      }
      .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 24px;
        color: var(--color-primary);
        text-decoration: none;
        font-size: 0.95rem;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      article {
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 32px;
      }
      .meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }
      .date {
        color: var(--color-subtext);
        font-size: 0.9rem;
      }
      .category-badge {
        display: inline-block;
        background-color: #eff6ff;
        color: var(--color-primary);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 9999px;
        border: 1px solid #bfdbfe;
      }
      h1 {
        margin: 0 0 24px 0;
        font-size: 1.8rem;
        line-height: 1.4;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 16px;
      }
      .eyecatch {
        margin-bottom: 24px;
        border-radius: 6px;
        overflow: hidden;
      }
      .eyecatch img {
        width: 100%;
        height: auto;
        display: block;
      }
      .content {
        margin-top: 24px;
      }
      .content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/" class="back-link">← トップページに戻る</a>

      {blog ? (
        <article>
          <div class="meta">
            <span class="date">{formatDate(blog.publishedAt || blog.createdAt)}</span>
            {blog.category && <span class="category-badge">{blog.category.name}</span>}
          </div>
          <h1>{blog.title}</h1>
          {(blog.mainVisual || blog.eyecatch) && (() => {
            const visual = blog.mainVisual || blog.eyecatch;
            return visual?.url ? (
              <div class="eyecatch">
                <img
                  src={visual.url}
                  alt={blog.title || 'メインビジュアル'}
                  width={visual.width}
                  height={visual.height}
                />
              </div>
            ) : null;
          })()}
          <div class="content" set:html={blog.content} />
        </article>
      ) : (
        <p>記事が見つかりませんでした。</p>
      )}
    </div>
  </body>
</html>
