---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNewsList, getBanner, getBlogList, type Banner, type Blog } from "../library/microcms";
import { sitePath } from "../library/site";

let newsList: any[] = [];
let blogList: Blog[] = [];
let banner: Banner | null = null;
let errorMessage = "";

try {
  const [newsResponse, bannerResponse, blogResponse] = await Promise.all([
    getNewsList({ orders: "-publishedAt" }),
    getBanner().catch(() => null),
    getBlogList({ orders: "-publishedAt" }).catch(() => ({ contents: [] })),
  ]);
  newsList = newsResponse.contents;
  banner = bannerResponse;
  blogList = blogResponse.contents;
} catch (error: any) {
  errorMessage = "microCMSからのデータ取得に失敗しました。.envのAPIキーが正しく設定されているかご確認ください。";
}

function formatDate(dateString: string): string {
  if (!dateString) return "";
  const date = new Date(dateString);
  return date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}
---

<BaseLayout title="ホーム" description="お知らせとブログの一覧です。">
  <section class="mb-7">
    <h1 class="mb-2 text-3xl font-bold tracking-tight text-gray-900">お知らせ・ブログ</h1>
    <p class="m-0 text-gray-500">microCMS + Astro で構築されたサイトです</p>
  </section>

  {
    banner && banner.image && (
      <section class="mb-8">
        {banner.url ? (
          <a
            href={banner.url}
            class="block overflow-hidden rounded-lg border border-gray-200 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={banner.image.url}
              alt={banner.description || "バナー"}
              width={banner.image.width}
              height={banner.image.height}
              class="block h-auto w-full object-cover"
            />
          </a>
        ) : (
          <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm">
            <img
              src={banner.image.url}
              alt={banner.description || "バナー"}
              width={banner.image.width}
              height={banner.image.height}
              class="block h-auto w-full object-cover"
            />
          </div>
        )}
      </section>
    )
  }

  <main>
    {
      errorMessage && (
        <div class="mb-6 rounded-lg border border-red-400 bg-red-100 px-4 py-4 text-red-800">
          <p class="m-0">{errorMessage}</p>
        </div>
      )
    }

    <section id="news">
      <h2 class="mb-4 border-l-4 border-blue-600 pl-3 text-2xl font-bold text-gray-900">お知らせ</h2>
      {
        newsList.length === 0 && !errorMessage && (
          <div class="px-4 py-10 text-center text-gray-500">
            <p>お知らせはまだ投稿されていません。</p>
          </div>
        )
      }

      <ul class="m-0 list-none p-0">
        {
          newsList.map((item) => (
            <li class="mb-4 rounded-lg border border-gray-200 bg-white transition hover:-translate-y-0.5 hover:shadow-md">
              <a href={sitePath(`/news/${item.id}/`)} class="block p-5 text-inherit no-underline">
                <div class="mb-1.5 flex items-center gap-2.5">
                  <span class="text-sm text-gray-500">{formatDate(item.publishedAt || item.createdAt)}</span>
                  {item.category && (
                    <span class="rounded-full border border-blue-200 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-600">
                      {item.category.name}
                    </span>
                  )}
                </div>
                <h3 class="m-0 text-xl font-semibold text-gray-800 group-hover:text-blue-600 hover:text-blue-600">
                  {item.title}
                </h3>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12" id="blog">
      <h2 class="mb-4 border-l-4 border-blue-600 pl-3 text-2xl font-bold text-gray-900">ブログ</h2>
      {
        blogList.length === 0 && !errorMessage && (
          <div class="px-4 py-10 text-center text-gray-500">
            <p>ブログ記事はまだ投稿されていません。</p>
          </div>
        )
      }

      <ul class="m-0 list-none p-0">
        {
          blogList.map((item) => {
            const visual = item.mainVisual || item.eyecatch;
            return (
              <li class="mb-4 rounded-lg border border-gray-200 bg-white transition hover:-translate-y-0.5 hover:shadow-md">
                <a href={sitePath(`/blog/${item.id}/`)} class="block p-5 text-inherit no-underline">
                  <div class="flex items-center gap-4">
                    {visual?.url && (
                      <div class="h-20 w-[120px] shrink-0 overflow-hidden rounded-md bg-gray-100">
                        <img
                          src={visual.url}
                          alt={item.title || "メインビジュアル"}
                          loading="lazy"
                          class="block h-full w-full object-cover"
                        />
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <div class="mb-1.5 flex items-center gap-2.5">
                        <span class="text-sm text-gray-500">{formatDate(item.publishedAt || item.createdAt)}</span>
                        {item.category && (
                          <span class="rounded-full border border-blue-200 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-600">
                            {item.category.name}
                          </span>
                        )}
                      </div>
                      <h3 class="m-0 text-xl font-semibold text-gray-800 hover:text-blue-600">{item.title}</h3>
                    </div>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</BaseLayout>
