---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRefCard from "../components/ContentRefCard.astro";
import CustomFieldBlock from "../components/CustomFieldBlock.astro";
import { getAbout, type About } from "../library/microcms";
import { sitePath } from "../library/site";

let about: About | null = null;
try {
  about = await getAbout();
} catch (e) {
  console.error("About取得エラー", e);
}

const relatedBlogs = about?.['fukusu-1-1'] ?? [];
const customField = about?.['custom-1-1'];
---

<BaseLayout title={about?.title || "About"}>
  <a href={sitePath("/")} class="mb-6 inline-block text-[0.95rem] text-blue-600 no-underline hover:underline">
    ← トップへ戻る
  </a>
  {
    about ? (
      <div class="space-y-8">
        <article class="rounded-lg border border-gray-200 bg-white p-8">
          <h1 class="mb-6 text-3xl font-bold text-gray-900">{about.title}</h1>
          {about.content && <div class="cms-content" set:html={about.content} />}
        </article>

        {relatedBlogs.length > 0 && (
          <section>
            <h2 class="mb-4 border-l-4 border-blue-600 pl-3 text-2xl font-bold text-gray-900">
              関連ブログ
            </h2>
            <ul class="m-0 grid list-none gap-3 p-0">
              {relatedBlogs.map((item) => (
                <li>
                  <ContentRefCard
                    id={item.id}
                    title={item.title}
                    hrefBase="blog"
                    imageUrl={item.mainVisual?.url}
                    excerptHtml={item.content}
                  />
                </li>
              ))}
            </ul>
          </section>
        )}

        {customField && (
          <section>
            <h2 class="mb-4 border-l-4 border-blue-600 pl-3 text-2xl font-bold text-gray-900">
              カスタムフィールド
            </h2>
            <CustomFieldBlock block={customField} />
          </section>
        )}
      </div>
    ) : (
      <p>About情報が取得できませんでした。</p>
    )
  }
</BaseLayout>
