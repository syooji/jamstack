---
import { getNewsList, getNewsDetail, type News } from '../../library/microcms';

/**
 * ビルド時に全記事のパス（URL）を生成する関数
 */
export async function getStaticPaths() {
  try {
    const response = await getNewsList({
      fields: ['id'],
      limit: 100,
    });
    return response.contents.map((content) => ({
      params: {
        contentId: content.id,
      },
    }));
  } catch (error) {
    // API未接続時の一時的なフォールバック
    return [];
  }
}

// URLパラメータから記事IDを取得
const { contentId } = Astro.params;

// 記事詳細データを取得
let news: News | null = null;
if (contentId) {
  try {
    news = await getNewsDetail(contentId as string);
  } catch (error) {
    news = null;
  }
}

/**
 * 日付フォーマット関数
 */
function formatDate(dateString?: string): string {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{news ? `${news.title} - お知らせ` : 'お知らせ'}</title>
    <style>
      :root {
        --color-primary: #2563eb;
        --color-text: #1f2937;
        --color-subtext: #6b7280;
        --color-bg: #f9fafb;
        --color-card-bg: #ffffff;
        --color-border: #e5e7eb;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.8;
      }
      .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 24px;
        color: var(--color-primary);
        text-decoration: none;
        font-size: 0.95rem;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      article {
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 32px;
      }
      .meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }
      .date {
        color: var(--color-subtext);
        font-size: 0.9rem;
      }
      .category-badge {
        display: inline-block;
        background-color: #eff6ff;
        color: var(--color-primary);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 9999px;
        border: 1px solid #bfdbfe;
      }
      h1 {
        margin: 0 0 24px 0;
        font-size: 1.8rem;
        line-height: 1.4;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 16px;
      }
      .content {
        margin-top: 24px;
      }
      .content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href={`${import.meta.env.BASE_URL}`} class="back-link">← お知らせ一覧に戻る</a>

      {news ? (
        <article>
          <div class="meta">
            <span class="date">{formatDate(news.publishedAt || news.createdAt)}</span>
            {news.category && <span class="category-badge">{news.category.name}</span>}
          </div>
          <h1>{news.title}</h1>
          <div class="content" set:html={news.content} />
        </article>
      ) : (
        <p>記事が見つかりませんでした。</p>
      )}
    </div>
  </body>
</html>
