---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsList, getNewsDetail, type News } from '../../library/microcms';
import { sitePath } from '../../library/site';

export async function getStaticPaths() {
  try {
    const response = await getNewsList({
      fields: ['id'],
      limit: 100,
    });
    return response.contents.map((content) => ({
      params: {
        contentId: content.id,
      },
    }));
  } catch (error) {
    return [];
  }
}

const { contentId } = Astro.params;

let news: News | null = null;
if (contentId) {
  try {
    news = await getNewsDetail(contentId as string);
  } catch (error) {
    news = null;
  }
}

function formatDate(dateString?: string): string {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

<BaseLayout title={news ? `${news.title}` : 'お知らせ'}>
  <a href={sitePath('/#news')} class="mb-6 inline-block text-[0.95rem] text-blue-600 no-underline hover:underline">
    ← お知らせ一覧に戻る
  </a>

  {
    news ? (
      <article class="rounded-lg border border-gray-200 bg-white p-8">
        <div class="mb-3 flex items-center gap-3">
          <span class="text-sm text-gray-500">{formatDate(news.publishedAt || news.createdAt)}</span>
          {news.category && (
            <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-sm font-semibold text-blue-600">
              {news.category.name}
            </span>
          )}
        </div>
        <h1 class="mb-6 border-b border-gray-200 pb-4 text-3xl font-bold leading-snug text-gray-900">{news.title}</h1>
        <div class="cms-content mt-6" set:html={news.content} />

        {news.relatedInformationCF && (news.relatedInformationCF.title || news.relatedInformationCF.summary) && (
          <aside class="mt-10 rounded-lg border border-slate-200 border-l-4 border-l-blue-600 bg-slate-50 px-6 py-5">
            {news.relatedInformationCF.title && (
              <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-blue-800">
                <span aria-hidden="true">📌</span>
                {news.relatedInformationCF.title}
              </h2>
            )}
            {news.relatedInformationCF.summary && (
              <div class="cms-content" set:html={news.relatedInformationCF.summary} />
            )}
          </aside>
        )}
      </article>
    ) : (
      <p>記事が見つかりませんでした。</p>
    )
  }
</BaseLayout>
