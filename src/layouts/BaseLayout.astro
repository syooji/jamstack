---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../library/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${SITE_NAME} のコーポレートサイトです。` } = Astro.props;
const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`.replace(/\/{2,}/g, '/');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-gray-50 font-sans text-gray-800 antialiased">
    <div class="flex min-h-screen flex-col">
      <Header />
      <div class="flex-1">
        <div class="mx-auto max-w-3xl px-5 py-8 pb-12">
          <slot />
        </div>
      </div>
      <Footer />
    </div>
  </body>
</html>
