---
import { SITE_NAME, NAV_ITEMS, sitePath } from '../library/site';

const pathname = Astro.url.pathname;
---

<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-3xl flex-col items-start gap-2.5 px-5 py-3.5 sm:min-h-16 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-0">
    <a
      class="shrink-0 text-xl font-bold tracking-wide text-gray-800 no-underline hover:text-blue-600"
      href={sitePath('/')}
    >
      {SITE_NAME}
    </a>
    <nav aria-label="グローバルメニュー">
      <ul class="m-0 flex list-none flex-wrap justify-start gap-x-4 gap-y-1 p-0 sm:justify-end">
        {
          NAV_ITEMS.map((item) => {
            const href = sitePath(item.href);
            const isHome = item.href === '/';
            const isCurrent =
              (isHome && (pathname === '/' || pathname === '' || pathname === import.meta.env.BASE_URL)) ||
              (!isHome && !item.href.includes('#') && pathname.includes(item.href.replace(/\/$/, '')));
            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'py-1 text-sm font-medium no-underline hover:text-blue-600',
                    isCurrent ? 'text-blue-600' : 'text-gray-500',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
